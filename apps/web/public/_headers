# Security headers for Cloudflare static asset responses.
#
# SCOPE: this file only applies to responses served by Cloudflare's asset handler
# (everything under dist/client). It does NOT apply to Worker-generated
# responses, so the HTML for every route gets its headers from src/server.ts
# instead. Both are kept: this file covers an asset fetched directly, the server
# entry covers the documents.
#
# DO NOT hand-edit the values below. They are asserted against
# STATIC_ASSET_HEADERS in src/security-headers.ts by src/security-headers.test.ts,
# so editing one side without the other fails the test suite. That test is the
# only thing preventing the two delivery paths from drifting apart.
#
# The document CSP differs from the one here by a single directive: it carries a
# per-request nonce in script-src, which a static file cannot express. Nothing
# under dist/client is an inline script, so plain 'self' suffices here.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: script-src 'self'; default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.github.com; form-action 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
